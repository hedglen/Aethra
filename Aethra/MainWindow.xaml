<Window
    x:Class="Aethra.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aethra"
    xmlns:controls="using:Aethra.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Aethra">

    <controls:CursorAwareGrid x:Name="RootGrid" Background="{StaticResource AethraSurfaceBrush}" AllowDrop="True" DragEnter="Grid_DragEnter" Drop="Grid_Drop" PointerPressed="RootGrid_PointerPressed" PointerMoved="RootGrid_PointerMoved">
        <Grid.Resources>
        <Style x:Key="ChromeIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="{StaticResource AethraTextBrush}"/>
        </Style>

        <Style x:Key="TransportIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource AethraTextBrush}"/>
        </Style>

        <Style x:Key="PrimaryPlayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{StaticResource AethraTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AethraAccentBrush}"/>
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="CornerRadius" Value="32"/>
            <Setter Property="Foreground" Value="#111111"/>
        </Style>

        <Style x:Key="RailButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="{StaticResource AethraTextBrush}"/>
        </Style>

        <Style x:Key="RailSubButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="{StaticResource AethraMutedTextBrush}"/>
        </Style>

        <Style x:Key="PanelActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="{StaticResource AethraPanelElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AethraDividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="{StaticResource AethraTextBrush}"/>
        </Style>
        </Grid.Resources>
        <controls:CursorAwareGrid x:Name="VideoContainer"
                                  Background="{StaticResource AethraVideoBrush}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  PointerPressed="VideoContainer_PointerPressed">
            <SwapChainPanel x:Name="GpuVideoSurface"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"/>

            <Image x:Name="VideoFrame"
                   Stretch="Uniform"
                   IsHitTestVisible="False"/>
        </controls:CursorAwareGrid>

        <Grid x:Name="TopChrome" VerticalAlignment="Top" Height="40" Background="{StaticResource AethraChromeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource ChromeIconButtonStyle}"
                    Click="BackButton_Click"
                    ToolTipService.ToolTip="Back">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" FontSize="18"/>
            </Button>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="12">
                <Border Width="24"
                        Height="24"
                        CornerRadius="12"
                        BorderBrush="{StaticResource AethraAccentBrush}"
                        BorderThickness="1"
                        Background="{StaticResource AethraPanelElevatedBrush}">
                    <FontIcon FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE768;"
                              FontSize="12"
                              Foreground="{StaticResource AethraAccentBrush}"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Aethra"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AethraTextBrush}"/>
                    <TextBlock Text="Clarity in every frame."
                               Margin="0,-2,0,0"
                               FontSize="10"
                               Foreground="{StaticResource AethraMutedTextBrush}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border x:Name="CommandRail"
                Width="64"
                Margin="0,40,0,156"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="{StaticResource AethraRailBrush}"
                BorderBrush="{StaticResource AethraDividerBrush}"
                BorderThickness="0,0,1,0">
            <Grid Padding="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Style="{StaticResource RailButtonStyle}"
                        Click="RailToggleButton_Click"
                        ToolTipService.ToolTip="Toggle command rail">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon x:Name="RailToggleIcon"
                                  FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE700;"
                                  FontSize="18"
                                  Foreground="{StaticResource AethraAccentBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    Tag="RailExpanded"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Command"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AethraTextBrush}"/>
                            <TextBlock Text="Media tools"
                                       FontSize="11"
                                       Foreground="{StaticResource AethraMutedTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="0,8,0,8">
                    <StackPanel Spacing="2">
                        <Button Style="{StaticResource RailButtonStyle}"
                                Click="RailMediaButton_Click"
                                ToolTipService.ToolTip="Media">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE8B7;"
                                          FontSize="18"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Tag="RailExpanded"
                                           Text="Media"
                                           VerticalAlignment="Center"
                                           FontSize="14"/>
                                <FontIcon Grid.Column="2"
                                          FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE70D;"
                                          FontSize="12"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <StackPanel x:Name="MediaRailSubMenu"
                                    Visibility="Collapsed"
                                    Spacing="2"
                                    Margin="0,0,0,6">
                            <Button Style="{StaticResource RailSubButtonStyle}"
                                    Click="RailOpenFileButton_Click">
                                <TextBlock Tag="RailExpanded" Text="Open file" Margin="60,0,0,0" VerticalAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource RailSubButtonStyle}"
                                    Click="RailOpenFolderButton_Click">
                                <TextBlock Tag="RailExpanded" Text="Open folder" Margin="60,0,0,0" VerticalAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource RailSubButtonStyle}"
                                    Click="RailRecentButton_Click">
                                <TextBlock Tag="RailExpanded" Text="Recent files" Margin="60,0,0,0" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <Button Style="{StaticResource RailButtonStyle}"
                                Click="RailPlaylistButton_Click"
                                ToolTipService.ToolTip="Playlist">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE8FD;"
                                          FontSize="18"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Tag="RailExpanded"
                                           Text="Playlist"
                                           VerticalAlignment="Center"
                                           FontSize="14"/>
                                <FontIcon Grid.Column="2"
                                          FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE70D;"
                                          FontSize="12"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <StackPanel x:Name="PlaylistRailSubMenu"
                                    Visibility="Collapsed"
                                    Spacing="2"
                                    Margin="0,0,0,6">
                            <Button Style="{StaticResource RailSubButtonStyle}"
                                    Click="RailPlaylistQueueButton_Click">
                                <TextBlock Tag="RailExpanded" Text="Queue" Margin="60,0,0,0" VerticalAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource RailSubButtonStyle}"
                                    Click="RailPlaylistImportButton_Click">
                                <TextBlock Tag="RailExpanded" Text="Import" Margin="60,0,0,0" VerticalAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource RailSubButtonStyle}"
                                    Click="RailPlaylistExportButton_Click">
                                <TextBlock Tag="RailExpanded" Text="Export" Margin="60,0,0,0" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <Button Style="{StaticResource RailButtonStyle}"
                                Click="RailEqualizerButton_Click"
                                ToolTipService.ToolTip="Equalizer">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE9E9;"
                                          FontSize="18"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Tag="RailExpanded"
                                           Text="Equalizer"
                                           VerticalAlignment="Center"
                                           FontSize="14"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource RailButtonStyle}"
                                Click="RailToolsButton_Click"
                                ToolTipService.ToolTip="Tools">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE713;"
                                          FontSize="18"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Tag="RailExpanded"
                                           Text="Tools"
                                           VerticalAlignment="Center"
                                           FontSize="14"/>
                                <FontIcon Grid.Column="2"
                                          FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE70D;"
                                          FontSize="12"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <StackPanel x:Name="ToolsRailSubMenu"
                                    Visibility="Collapsed"
                                    Spacing="2"
                                    Margin="0,0,0,6">
                            <Button Style="{StaticResource RailSubButtonStyle}"
                                    Click="RailEffectsButton_Click">
                                <TextBlock Tag="RailExpanded" Text="Effects" Margin="60,0,0,0" VerticalAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource RailSubButtonStyle}"
                                    Click="RailPreferencesButton_Click">
                                <TextBlock Tag="RailExpanded" Text="Preferences" Margin="60,0,0,0" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Spacing="2">
                    <Button Style="{StaticResource RailButtonStyle}"
                            Click="RailHelpButton_Click"
                            ToolTipService.ToolTip="Help">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE897;"
                                      FontSize="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Tag="RailExpanded"
                                       Text="Help"
                                       VerticalAlignment="Center"
                                       FontSize="14"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="EmbeddedPanelHost"
                Visibility="Collapsed"
                Width="360"
                Margin="64,40,0,156"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="{StaticResource AethraPanelBrush}"
                BorderBrush="{StaticResource AethraAccentBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Padding="20,18,14,14"
                      Background="{StaticResource AethraPanelElevatedBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="EmbeddedPanelTitle"
                                   Text="Media"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AethraTextBrush}"/>
                        <TextBlock x:Name="EmbeddedPanelSubtitle"
                                   Text="Open files and browse recent media."
                                   FontSize="12"
                                   Foreground="{StaticResource AethraMutedTextBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource ChromeIconButtonStyle}"
                            Click="CloseEmbeddedPanelButton_Click"
                            ToolTipService.ToolTip="Close panel">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="14"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Padding="20"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <StackPanel x:Name="MediaEmbeddedPanel" Spacing="12">
                            <Button Style="{StaticResource PanelActionButtonStyle}" Click="RailOpenFileButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E5;" FontSize="14"/>
                                    <TextBlock Text="Open file"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PanelActionButtonStyle}" Click="RailOpenFolderButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B7;" FontSize="14"/>
                                    <TextBlock Text="Open folder"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PanelActionButtonStyle}" Click="RailRecentButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE81C;" FontSize="14"/>
                                    <TextBlock Text="Recent files"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="Recent"
                                       Margin="0,14,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AethraMutedTextBrush}"/>
                            <TextBlock Text="No recent files yet."
                                       FontSize="13"
                                       Foreground="{StaticResource AethraMutedTextBrush}"/>
                        </StackPanel>

                        <StackPanel x:Name="PlaylistEmbeddedPanel" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Up next"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AethraMutedTextBrush}"/>
                            <Border Background="{StaticResource AethraPanelElevatedBrush}"
                                    BorderBrush="{StaticResource AethraDividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <StackPanel Margin="12" Spacing="10">
                                    <TextBlock Text="Queue is empty" FontWeight="SemiBold" Foreground="{StaticResource AethraTextBrush}"/>
                                    <TextBlock Text="No playlist items are loaded."
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource AethraMutedTextBrush}"/>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource PanelActionButtonStyle}" Click="RailPlaylistImportButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B5;" FontSize="14"/>
                                    <TextBlock Text="Import playlist"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PanelActionButtonStyle}" Click="RailPlaylistExportButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74E;" FontSize="14"/>
                                    <TextBlock Text="Export playlist"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel x:Name="EqualizerEmbeddedPanel" Spacing="14" Visibility="Collapsed">
                            <ToggleSwitch Header="Enable equalizer" OffContent="Off" OnContent="On" Foreground="White"/>
                            <Slider Header="Bass" Minimum="-12" Maximum="12" Value="0" Foreground="{StaticResource AethraAccentBrush}"/>
                            <Slider Header="Mid" Minimum="-12" Maximum="12" Value="0" Foreground="{StaticResource AethraAccentBrush}"/>
                            <Slider Header="Treble" Minimum="-12" Maximum="12" Value="0" Foreground="{StaticResource AethraAccentBrush}"/>
                            <ComboBox Header="Preset" SelectedIndex="0" Foreground="White">
                                <ComboBoxItem Content="Flat"/>
                                <ComboBoxItem Content="Dialogue"/>
                                <ComboBoxItem Content="Music"/>
                                <ComboBoxItem Content="Night"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel x:Name="ToolsEmbeddedPanel" Spacing="12" Visibility="Collapsed">
                            <Button Style="{StaticResource PanelActionButtonStyle}" Click="RailEffectsButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71C;" FontSize="14"/>
                                    <TextBlock Text="Effects and filters"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PanelActionButtonStyle}" Click="RailPreferencesButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="14"/>
                                    <TextBlock Text="Preferences"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PanelActionButtonStyle}" Click="RailConverterButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE895;" FontSize="14"/>
                                    <TextBlock Text="Media converter"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel x:Name="HelpEmbeddedPanel" Spacing="12" Visibility="Collapsed">
                            <Button Style="{StaticResource PanelActionButtonStyle}" Click="SettingsButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="14"/>
                                    <TextBlock Text="Open settings"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Documentation and diagnostics are not connected yet."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource AethraMutedTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid x:Name="TransportBar"
              VerticalAlignment="Bottom"
              Height="156"
              Padding="24,10,20,18"
              Background="{StaticResource AethraChromeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2"
                    Height="1"
                    VerticalAlignment="Top"
                    Background="{StaticResource AethraAccentSubtleBrush}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CurrentTimeText"
                           Text="0:00"
                           VerticalAlignment="Center"
                           FontSize="18"
                           Foreground="{StaticResource AethraTextBrush}"/>

                <Slider x:Name="NativeProgressBar"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        StepFrequency="0.01"
                        SmallChange="0.1"
                        LargeChange="5"
                        Margin="20,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource AethraAccentBrush}"
                        ValueChanged="NativeProgressBar_ValueChanged"/>

                <TextBlock x:Name="DurationText"
                           Grid.Column="2"
                           Text="--:--"
                           VerticalAlignment="Center"
                           FontSize="18"
                           Foreground="{StaticResource AethraTextBrush}"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="MediaTitleText"
                           Text="Ready"
                           VerticalAlignment="Center"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AethraTextBrush}"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <Button Style="{StaticResource TransportIconButtonStyle}"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Previous">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE892;" FontSize="20"/>
                    </Button>

                    <Button Style="{StaticResource TransportIconButtonStyle}"
                            Click="SeekBackButton_Click"
                            ToolTipService.ToolTip="Back 10 seconds">
                        <TextBlock Text="↶10"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                    </Button>

                    <Button Style="{StaticResource PrimaryPlayButtonStyle}"
                            Click="PlayPauseButton_Click"
                            ToolTipService.ToolTip="Play or pause">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" FontSize="28"/>
                    </Button>

                    <Button Style="{StaticResource TransportIconButtonStyle}"
                            Click="SeekForwardButton_Click"
                            ToolTipService.ToolTip="Forward 30 seconds">
                        <TextBlock Text="30↷"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                    </Button>

                    <Button Style="{StaticResource TransportIconButtonStyle}"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Next">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE893;" FontSize="20"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <Button Style="{StaticResource TransportIconButtonStyle}"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Captions">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEDE4;" FontSize="18"/>
                    </Button>

                    <Button Style="{StaticResource TransportIconButtonStyle}"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Volume">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE767;" FontSize="18"/>
                    </Button>

                    <Button Style="{StaticResource TransportIconButtonStyle}"
                            Click="FullscreenButton_Click"
                            ToolTipService.ToolTip="Fullscreen">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE740;" FontSize="18"/>
                    </Button>

                    <Button Style="{StaticResource TransportIconButtonStyle}"
                            Click="MoreButton_Click"
                            ToolTipService.ToolTip="More">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE712;" FontSize="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="SettingsHost" Visibility="Collapsed" HorizontalAlignment="Right">
            <local:SettingsPanel x:Name="Settings"
                                 CloseRequested="Settings_CloseRequested"
                                 OpenAllSettingsRequested="Settings_OpenAllSettingsRequested"/>
        </Grid>

        <Grid x:Name="FullSettingsHost" Visibility="Collapsed">
            <local:FullSettingsPanel x:Name="FullSettings"
                                     CloseRequested="FullSettings_CloseRequested"/>
        </Grid>
    </controls:CursorAwareGrid>
</Window>
