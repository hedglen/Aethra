<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Aethra.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aethra">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AethraSurfaceBrush" Color="#0D0D0D"/>
            <SolidColorBrush x:Key="AethraVideoBrush" Color="#000000"/>
            <SolidColorBrush x:Key="AethraChromeBrush" Color="#F2141414"/>
            <SolidColorBrush x:Key="AethraRailBrush" Color="#F20B0711"/>
            <SolidColorBrush x:Key="AethraPanelBrush" Color="#F214111A"/>
            <SolidColorBrush x:Key="AethraPanelElevatedBrush" Color="#F21C1824"/>
            <SolidColorBrush x:Key="AethraDividerBrush" Color="#303030"/>
            <SolidColorBrush x:Key="AethraTextBrush" Color="#F2F2F2"/>
            <SolidColorBrush x:Key="AethraMutedTextBrush" Color="#9FA0A4"/>
            <SolidColorBrush x:Key="AethraAccentBrush" Color="#7B2FFF"/>
            <SolidColorBrush x:Key="AethraAccentSoftBrush" Color="#667B2FFF"/>
            <SolidColorBrush x:Key="AethraAccentSubtleBrush" Color="#267B2FFF"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
