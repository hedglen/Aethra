<UserControl
    x:Class="Aethra.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aethra"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AethraPanelBrush}" BorderBrush="{StaticResource AethraAccentBrush}" BorderThickness="1,0,0,0" Width="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="20">
            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AethraTextBrush}" VerticalAlignment="Center"/>
            <Button x:Name="CloseButton" Content="✕" Click="CloseButton_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="16"/>
        </Grid>

        <!-- All settings entry point -->
        <Button Grid.Row="1"
                x:Name="AllSettingsButton"
                Click="AllSettingsButton_Click"
                Margin="20,0,20,12"
                Padding="14,10"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Background="{StaticResource AethraPanelElevatedBrush}"
                BorderBrush="{StaticResource AethraAccentBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Foreground="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="16" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="All settings" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Full-screen view of every option" FontSize="11" Foreground="{StaticResource AethraMutedTextBrush}"/>
                </StackPanel>

                <FontIcon Grid.Column="2" FontFamily="Segoe Fluent Icons" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Button>

        <!-- Category Navigation -->
        <NavigationView x:Name="NavView" Grid.Row="2" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" SelectionChanged="NavView_SelectionChanged" OpenPaneLength="120" Foreground="White">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Video" Tag="Video" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE714;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Shaders" Tag="Shaders">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Audio" Tag="Audio">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE720;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Accent" Tag="Accent">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="20">
                <!-- Video Settings -->
                <ScrollViewer x:Name="VideoPanel" Visibility="Visible">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Video Output" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                        <ComboBox x:Name="VOCombo" SelectedIndex="0" HorizontalAlignment="Stretch" Foreground="White">
                            <ComboBoxItem Content="GPU Next (Modern)"/>
                            <ComboBoxItem Content="GPU (Standard)"/>
                        </ComboBox>

                        <TextBlock Text="Hardware Decoding" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                        <ComboBox x:Name="HwDecCombo" SelectedIndex="1" HorizontalAlignment="Stretch" Foreground="White">
                            <ComboBoxItem Content="Auto"/>
                            <ComboBoxItem Content="NVDEC (NVIDIA)"/>
                            <ComboBoxItem Content="DXVA2 (Windows)"/>
                            <ComboBoxItem Content="Copy (CPU callback)"/>
                        </ComboBox>

                        <ToggleSwitch x:Name="InterpolationToggle" Header="Video Interpolation (Smooth Motion)" OffContent="Off" OnContent="On" Foreground="White"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Shaders Settings -->
                <ScrollViewer x:Name="ShadersPanel" Visibility="Collapsed">
                     <StackPanel Spacing="16">
                        <TextBlock Text="Active Shader Profile" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                        <RadioButton GroupName="Shaders" Content="None (Basic Scaling)" IsChecked="True" Foreground="White"/>
                        <RadioButton GroupName="Shaders" Content="FSRCNNX (Live Action)" Foreground="White"/>
                        <RadioButton GroupName="Shaders" Content="Anime4K (Animation)" Foreground="White"/>
                        <RadioButton GroupName="Shaders" Content="SSimDownscaler + FSRCNNX" Foreground="White"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Audio Settings -->
                <ScrollViewer x:Name="AudioPanel" Visibility="Collapsed">
                    <StackPanel Spacing="16">
                         <TextBlock Text="Volume Normalization" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                         <ToggleSwitch Header="Dynamic Range Compression" OffContent="Off" OnContent="On" Foreground="White"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AccentPanel" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Accent color" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="AccentPreviewSwatch"
                                    Width="32"
                                    Height="32"
                                    CornerRadius="16"
                                    Background="{StaticResource AethraAccentBrush}"
                                    BorderBrush="{StaticResource AethraAccentSoftBrush}"
                                    BorderThickness="2"/>

                            <TextBox x:Name="AccentHexBox"
                                     Grid.Column="1"
                                     Header="Hex"
                                     PlaceholderText="#7B2FFF"
                                     TextChanged="AccentHexBox_TextChanged"
                                     Foreground="White"/>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Click="ApplyAccentButton_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Background="{StaticResource AethraAccentBrush}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" FontSize="12"/>
                                    <TextBlock Text="Apply"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Click="ResetAccentButton_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Background="{StaticResource AethraPanelElevatedBrush}"
                                    BorderBrush="{StaticResource AethraDividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Foreground="White"
                                    Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="12"/>
                                    <TextBlock Text="Reset"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="AccentStatusText"
                                   FontSize="12"
                                   Foreground="{StaticResource AethraMutedTextBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</UserControl>
